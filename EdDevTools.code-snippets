	"TalonFXControlPose": {
		"scope": "java",
		"prefix": "snTalonFXControlPose",
		"body": [
			"this.${1:motorName}.setControl(new PositionVoltage(${2:pose}).withSlot(${0:slotNumber}));"
		],
		"description": "TalonFX move to pose request"
	},
