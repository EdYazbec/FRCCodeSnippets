	"SparkMaxBrushlessCreate": {
		"scope": "java",
		"prefix": "snSparkMaxBrushlessCreate",
		"body": [
			"private final SparkMax ${1:motorName} = new SparkMax(${0:CANID}, MotorType.kBrushless);",
		],
		"description": "Creates a SparkMax motor object for a brushless motor"
	},
	"SparkMaxBrushedCreate": {
		"scope": "java",
		"prefix": "snSparkMaxBrushedCreate",
		"body": [
			"private final SparkMax ${1:motorName} = new SparkMax(${0:CANID}, MotorType.kBrushed);",
		],
		"description": "Creates a SparkMax motor object for a brushed motor"
	},
	"SparkMaxConfigBasic": {
		"scope": "java",
		"prefix": "snSparkMaxConfigBasic",
		"body": [
			"// SparkMax Basic Configuration",
			"",
			"SparkMaxConfig config = new SparkMaxConfig();",
			"",
			"// current limits",
			"config.smartCurrentLimit(${1:CurrentLimit});",
			"",
			"// Neutral mode",
			"// TODO: Pick one and delete the other",
			"config.idleMode(IdleMode.kCoast);",
			"config.idleMode(IdleMode.kBrake);",
			"",
			"// Motor direction",
			"// TODO: Test and select one, delete the other",
			"config.inverted(false);",
			"config.inverted(true);",
			"",
			"// apply the config",
			"this.${0:motorName}.configure(config, ResetMode.kResetSafeParameters, PersistMode.kPersistParameters);",
		],
		"description": "Basic SparkMax motor configuration"
	},
	"SparkMaxConfigPose": {
		"scope": "java",
		"prefix": "snSparkMaxConfigPosition",
		"body": [
			"// SparkMax Basic Positonal Configuration",
			"",
			"// https://docs.revrobotics.com/brushless/spark-max/parameters",
			"",
			"SparkMaxConfig config = new SparkMaxConfig();",
			"",
			"// Current Limits",
			"// TODO: Adjust as needed for your robot",
			"config.smartCurrentLimit(${1:CurrentLimit});",
			"",
			"// Neutral mode",
			"// TODO: Pick one and delete the other",
			"config.idleMode(IdleMode.kBrake);",
			"config.idleMode(IdleMode.kCoast);",
			"",
			"// Motor direction",
			"config.inverted(true);",
			"config.inverted(false);",
			"",
			"// PID",
			"// TODO: Tune for your robot",
			"config.closedLoop",
			".p(0.0)",
			".i(0.0)",
			".d(0.0);",
			"",
			"// Soft limits",
			"// TODO: Determine positional limits, set, and enable",
			"config.softLimit.forwardSoftLimit(0);",
			"config.softLimit.forwardSoftLimitEnabled(false);",
			"config.softLimit.reverseSoftLimit(0);",
			"config.softLimit.reverseSoftLimitEnabled(false);",
			"",
			"// apply the config",
			"this.${0:motorName}.configure(config, ResetMode.kResetSafeParameters, PersistMode.kPersistParameters);",
		],
		"description": "SparkMax Basic Positional Control Configuration"
	},
	"SparkMaxConfigFollower": {
		"scope": "java",
